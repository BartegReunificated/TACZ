{
  "weight": 0.35,
  "ads": {
    // 加数（多个配件的数值相加，作为第一个乘区）
    "addend": 0.02
  },
  "inaccuracy": {
    "multiplier": 1.0
  },
  "aim_inaccuracy": {
    "percent": -0.3,
    "multiplier": 1.0
  },
  "sneak_inaccuracy": {
    "multiplier": 1.0
  },
  "recoil": {
    "pitch": {
      "multiplier": 0.8
    },
    "yaw": {
      "multiplier": 0.8
    }
  },
  "effective_range": {
    "percent": 0.5,
    "multiplier": 1.0
  },
  "ammo_speed": {
    "percent": 0.1,
    "multiplier": 1.0
  },
  "silence": {
    // 声音传播的范围，如果默认是 50 格，这里填入 -10，那么消音后传播距离为 40 格
    "distance_addend": -20,
    // 是否使用专门的消音后的音源
    "use_silence_sound": true
  }
}